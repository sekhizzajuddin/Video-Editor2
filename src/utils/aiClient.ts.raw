40: export async function enhancePromptWithGemini(prompt: string, apiKey: string): Promise<string> {
41:   const systemPrompt = "You are an expert AI Video and Image prompt engineer. Enhance the following basic prompt into a highly detailed, cinematic, and professional prompt suitable for advanced AI video generators like Sora, Kling, or Midjourney. Focus on lighting, camera angles, atmosphere, and visual fidelity. Return ONLY the enhanced prompt string without any conversational filler or quotes.";
42:   const response = await fetch(`https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent?key=${apiKey}`, {
43:     method: "POST",
44:     headers: { "Content-Type": "application/json" },
45:     body: JSON.stringify({
46:       contents: [{ role: "user", parts: [{ text: `${systemPrompt}\n\nUser Prompt: ${prompt}` }] }]
47:     })
48:   });
49:   if (!response.ok) throw new Error("Failed to enhance prompt");
50:   const data = await response.json();
51:   return data.candidates?.[0]?.content?.parts?.[0]?.text ?? '';
52: }
