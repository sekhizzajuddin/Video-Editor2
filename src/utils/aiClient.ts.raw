54: export interface VideoScenePlan {
55:   duration: number; // in seconds
56:   narration: string;
57:   searchQuery: string;
58: }
59: 
60: export async function generateVideoScenesFromScript(script: string, totalDuration: number, apiKey: string): Promise<VideoScenePlan[]> {
61:   const systemPrompt = `You are an expert video director and stock footage researcher.
62: I am providing you with a script that has a total audio voiceover duration of ${totalDuration.toFixed(1)} seconds.
63: Your job is to break this script down into a sequence of consecutive video scenes to perfectly cover this duration.
64: 
65: RULES:
66: 1. Divide the script into logical scenes. Each scene should ideally be between 3 to 6 seconds long.
67: 2. The sum of the "duration" for all scenes MUST equal exactly ${totalDuration.toFixed(1)} seconds.
68: 3. For each scene, provide a "searchQuery" which is a 1-3 word search term to find relevant free stock video on Pexels (e.g., "business meeting", "nature forest", "coding computer", "happy family"). Keep queries simple and generic for better search results.
69: 4. Provide the exact "narration" chunk spoken during that scene for subtitles.
70: 
71: Return ONLY a JSON array, nothing else. Format:
72: [
73:   { "duration": 4.5, "narration": "Welcome to the future of video editing.", "searchQuery": "futuristic technology" },
74:   { "duration": 3.2, "narration": "Where everything is automated.", "searchQuery": "robot manufacturing" }
75: ]`;
76: 
77:   const response = await fetch(`https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent?key=${apiKey}`, {
78:     method: "POST",
79:     headers: { "Content-Type": "application/json" },
80:     body: JSON.stringify({
81:       contents: [{ role: "user", parts: [{ text: `${systemPrompt}\n\nScript: ${script}` }] }],
82:       generationConfig: {
83:         responseMimeType: "application/json"
84:       }
85:     })
86:   });
87: 
88:   if (!response.ok) {
89:     const err = await response.text();
90:     throw new Error(`Failed to generate scenes: ${err}`);
91:   }
92: 
93:   const data = await response.json();
94:   const text = data.candidates?.[0]?.content?.parts?.[0]?.text ?? '[]';
95:   try {
96:     const scenes: VideoScenePlan[] = JSON.parse(text);
97:     return scenes;
98:   } catch (e) {
99:     console.error("Error parsing scene plan JSON:", text);
100:     throw new Error("Invalid response from Gemini AI.");
